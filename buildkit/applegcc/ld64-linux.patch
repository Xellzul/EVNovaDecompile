+void Linker::applyAtomOverrides()
+{
+	const char* path = getenv("LD64_ATOM_OVERRIDE");
+	if ( path == NULL )
+		return;
+	std::map<std::string, std::string> table;
+	std::ifstream in(path);
+	std::string line;
+	while ( std::getline(in, line) ) {
+		// <object leaf>\t<symbol>\t<hex bytes>
+		size_t a = line.find('\t');
+		size_t b = line.find('\t', a+1);
+		if ( a == std::string::npos || b == std::string::npos )
+			continue;
+		std::string raw;
+		for (size_t i=b+1; i+1 < line.size(); i += 2)
+			raw.push_back((char)strtol(line.substr(i, 2).c_str(), NULL, 16));
+		table[line.substr(0, a) + "\t" + line.substr(a+1, b-a-1)] = raw;
+	}
+	uint32_t done = 0;
+	for (std::vector<ObjectFile::Atom*>::iterator it=fAllAtoms.begin(); it != fAllAtoms.end(); ++it) {
+		ObjectFile::Atom* atom = *it;
+		const char* name = atom->getName();
+		if ( name == NULL || atom->getFile() == NULL || atom->getFile()->getPath() == NULL )
+			continue;
+		const char* leaf = strrchr(atom->getFile()->getPath(), '/');
+		leaf = (leaf != NULL) ? leaf+1 : atom->getFile()->getPath();
+		std::map<std::string, std::string>::iterator pos = table.find(std::string(leaf) + "\t" + name);
+		if ( pos == table.end() )
+			continue;
+		mach_o::relocatable::BaseAtom* base = dynamic_cast<mach_o::relocatable::BaseAtom*>(atom);
+		if ( base == NULL )
+			continue;
+		base->setSize(pos->second.size());
+		gAtomOverride[atom] = pos->second;
+		++done;
+	}
+	fprintf(stderr, "ld: LD64_ATOM_OVERRIDE: %u of %lu atoms replaced\n", done, table.size());
+}
+
